{
  "checklist_title": "End-to-End ML Classification Project Checklist",
  "purpose": "Complete supervised-classification projects rigorously, with special emphasis on validating that the problem is a good ML fit before writing any code",
  "how_to_use": "Work phases in order. Phases 0 and 1 are gates: if the fit checks fail, stop or reframe before investing effort. Check off each item only when its verification step is demonstrably done.",
  "phases": [
    {
      "phase": 0,
      "name": "Problem Fit Assessment — THE GATE",
      "goal": "Determine whether this is actually a machine learning problem, and whether it is a GOOD one",
      "fit_criteria_good": {
        "description": "All of these should be true. Each unchecked item is a warning, and 2+ unchecked items usually mean 'reframe or abandon'.",
        "checks": [
          {
            "item": "A labeled dataset exists or is obtainable",
            "question": "Do historical examples exist with KNOWN correct answers (labels), and can I legally/ethically access them?",
            "red_flag": "No labels and labeling is impossible or prohibitively expensive — unsupervised or rules-based approaches may fit better"
          },
          {
            "item": "The output is predictable from available inputs",
            "question": "Is there a plausible causal or statistical relationship between available features and the target? Would a domain expert agree that the inputs contain signal?",
            "red_flag": "Expert says 'you cannot know that from this data' — no model fixes missing signal"
          },
          {
            "item": "Patterns are stable enough to learn",
            "question": "Are the patterns historical, or do they shift faster than you can collect data (adversarial, rapidly evolving markets, novel rare events)?",
            "red_flag": "Target shifts with every news cycle or adversary adapts weekly — model obsolesces before deployment"
          },
          {
            "item": "Enough data relative to complexity",
            "question": "Rough rule: hundreds of rows minimum for simple tabular problems, thousands for complex ones. Is sample size adequate per class?",
            "red_flag": "Rare class has < ~50-100 examples — extreme imbalance or thin data"
          },
          {
            "item": "Prediction is actionable and consequential",
            "question": "Will someone DO something differently based on the output? Is there a real cost asymmetry to map (missed positives vs false alarms)?",
            "red_flag": "Nobody knows what decision the prediction informs — build understanding/analytics instead"
          },
          {
            "item": "Errors are tolerable somewhere",
            "question": "Can the system tolerate occasional mistakes (recommendation, triage) or is an error unacceptable (structural safety, medical certification)? In the latter case ML can only be decision support, never sole authority.",
            "red_flag": "Zero-error requirement with legal liability — ML may assist but cannot own the decision"
          },
          {
            "item": "Not a fixed rule disguised as learning",
            "question": "Could a lookup table, deterministic formula, or business rule solve this? If yes, prefer that — cheaper, explainable, no drift.",
            "red_flag": "Simple rule already solves 95% of cases — ML adds fragility, not value"
          },
          {
            "item": "Not pure storage/computation/reporting",
            "question": "Is the task really about exact computation, aggregation, or reporting? Those belong to software engineering, not ML",
            "red_flag": "'Predict next quarter total from booked orders' is arithmetic, not learning"
          }
        ]
      },
      "fit_criteria_bad_examples": {
        "description": "Classic bad fits — recognize and reframe",
        "list": [
          "Insufficient or unlabeled data: cannot collect labels at all, or each label requires the expensive ground truth you are trying to predict",
          "Perfectly deterministic tasks: if a rule exists and is known, encode the rule",
          "Requires extrapolation far outside observed data: predicting values outside the training distribution with no supporting features",
          "Pure causality questions from observational data: 'would the outcome change if we intervened?' needs experimental design, not a classifier",
          "Tiny failure tolerance + sparse examples: rare catastrophic events (aircraft accidents, 1-in-10^6 defects) often lack enough positives to learn from",
          "Ethics/regulation forbid automated decisions: hiring, credit denial, medical authorization — constrained or prohibited in many jurisdictions"
        ],
        "better_alternatives_when_not_fit": [
          "No labels → unsupervised learning (clustering, anomaly detection) or manual labeling pilot",
          "Too little data → simpler models, domain-expert rules, or data acquisition first",
          "Concept drift → forecasting framework with scheduled retraining, or process redesign",
          "Decision-support-only domain → ML ranks/flags, human decides (aviation, medicine)"
        ]
      },
      "outputs_of_this_phase": [
        "One-sentence problem statement: 'Given [features], predict [target] so that [decision] can be made'",
        "Label definition and its source (who decided 'degraded', who decided 'poisonous')",
        "Cost asymmetry table: which error is worse, by how much",
        "Go / no-go decision, documented"
      ]
    },
    {
      "phase": 1,
      "name": "Data Acquisition and Understanding",
      "checks": [
        "Data source identified and access confirmed (file, database, API)",
        "Documentation read: column meanings, units, collection process, known quirks (sentinels like -999, '?' placeholders, unit changes over time)",
        "Row = one what? (one mushroom, one engine-cycle, one customer-month) — state the unit of observation explicitly",
        "Target column located; possible label leakage sources identified (columns recorded AFTER the outcome, IDs, timestamps of the event itself)",
        "License, privacy, and regulatory constraints checked (GDPR personal data, export-controlled aviation data)"
      ],
      "verification": "You can explain every column's meaning to a colleague without guessing"
    },
    {
      "phase": 2,
      "name": "Data Cleaning",
      "checks": [
        "Structure inspected: .info(), .describe(), .head() run; dtypes sane",
        "Missing values quantified per column, strategy chosen and justified (mode/mean/ffill/new-category/drop), and NEVER filled using test-set statistics",
        "Sentinel/impossible values found and converted to NaN (check min/max against domain knowledge)",
        "Duplicates detected and handled (exact rows, or business-key duplicates like same unit_id+cycle)",
        "Zero-variance columns identified and dropped (they carry no information)",
        "Impossible values filtered (negative speeds, ages of 300, temperatures beyond physical limits)"
      ],
      "verification": "df.isna().sum().sum() == 0 (or intentional), zero unintended duplicates, shape recorded"
    },
    {
      "phase": 2.5,
      "name": "Exploratory Data Analysis",
      "checks": [
        "Class balance measured — if minority class < ~10%, plan for imbalance (class_weight, resampling, metric choice beyond accuracy)",
        "Target relationship checked for the suspected key features (countplots, grouped distributions)",
        "Distributions and outliers inspected for every candidate feature",
        "Feature-target correlations / mutual information computed; top candidates shortlisted",
        "Feature-feature redundancy noted (correlated pairs — a flag for later interpretation)",
        "Time/group structure understood: are rows independent, or ordered/nested (cycles per engine, repeated customers)?"
      ],
      "verification": "At least one feature visually separates the classes, OR you have documented why the signal may be weak/distributed"
    },
    {
      "phase": 3,
      "name": "Preprocessing and Feature Engineering",
      "checks": [
        "Zero-variance / near-zero-variance features dropped",
        "Categorical encoding chosen appropriately: label/factorize for tree models; one-hot for distance/linear models",
        "Feature engineering done with domain logic (ratios, deltas from baseline, rolling stats) — NOT with peeking at test data",
        "All statistics computed on TRAINING data only (scalers, imputer values, encoder vocabularies fitted on train)",
        "Split designed to prevent leakage: grouped/TemporalTimeSeriesSplit if rows are correlated by entity or time; stratify by target otherwise",
        "random_state fixed everywhere for reproducibility",
        "Identifier columns (IDs, timestamps-as-ID) excluded from X"
      ],
      "verification": "Train/test group-disjointness check passes (empty intersection of unit/customer IDs) for grouped data; X contains no identifiers or target"
    },
    {
      "phase": 4,
      "name": "Baseline First",
      "checks": [
        "Dummy baseline built (DummyClassifier with most_frequent or stratified) — this is the number any real model must beat",
        "Simple interpretable model trained first (logistic regression, small decision tree) as a sanity anchor",
        "Primary model trained (e.g., Random Forest) with fixed random_state",
        "If naive row-level split gives suspiciously ~100% accuracy, suspect leakage and re-test with grouped split"
      ],
      "verification": "Primary model beats dummy baseline by a meaningful margin on the CHOSEN metric"
    },
    {
      "phase": 4.5,
      "name": "Metric Selection — Before Final Evaluation",
      "checks": [
        "Cost asymmetry identified from Phase 0 and translated into a metric: recall (don't miss failures), precision (don't spam alarms), F-beta with beta>1 when recall matters more",
        "Confusion matrix semantics memorized for YOUR encoding: which cell is the 'worst-case' error",
        "Class balance noted: with imbalance, accuracy alone is misleading — always pair with per-class recall/precision or PR curves"
      ],
      "verification": "Headline metric written down and justified in one sentence before looking at final test results"
    },
    {
      "phase": 5,
      "name": "Model Training and Honest Validation",
      "checks": [
        "Initial model trained with modest settings; train AND test performance recorded",
        "Overfitting check: train score ≫ test score → simplify model, regularize, or get more data",
        "Cross-validation run with folds matched to data structure (GroupKFold/TimeSeriesSplit for grouped/temporal data — NOT plain KFold)",
        "Alternative model families benchmarked (at least one linear, one tree-ensemble) in a comparison table",
        "Best model selected on validation/CV performance, not on the single test score"
      ],
      "verification": "CV mean ± std reported; test set touched only ONCE for final numbers"
    },
    {
      "phase": 5.5,
      "name": "Hyperparameter Tuning",
      "checks": [
        "Grid chosen with domain sense (a handful of meaningful values, not an explosion)",
        "Tuning scored on the SAFETY/ BUSINESS metric, not raw accuracy",
        "CV used inside GridSearchCV; test set still untouched",
        "Cost/complexity tradeoff considered: cheapest config within epsilon of best score preferred",
        "Tuned vs untuned compared on the held-out test set; improvement honestly reported (often marginal on easy datasets — say so)"
      ],
      "verification": "Best params, CV score, and test comparison printed; decision to adopt or keep simple model justified"
    },
    {
      "phase": 6,
      "name": "Evaluation and Error Analysis",
      "checks": [
        "Accuracy, confusion matrix, classification report printed with READABLE class names",
        "Worst-case error cell quantified explicitly (e.g., missed degradations, false edibles)",
        "Probability outputs extracted; predict_proba column order verified against clf.classes_",
        "Threshold analysis performed if errors are asymmetric: sweep thresholds, pick the operating point honoring the safety constraint",
        "Feature importances extracted and sanity-checked against domain knowledge and EDA",
        "Per-sample inspection of a handful of errors: any pattern (subgroup, sensor, time period)?"
      ],
      "verification": "Written paragraph states: what the model gets wrong, how often, why it matters, and what threshold/metric governs deployment"
    },
    {
      "phase": 6,
      "name": "Robustness Beyond a Single Split",
      "checks": [
        "Performance checked on at least one structurally different evaluation: another time period, another subgroup, another region/engine family",
        "Feature-importance stability checked across CV folds (does the 'key feature' hold?)",
        "Minimal-feature experiment run: does a tiny subset match full performance (simpler systems, cheaper data collection)?",
        "Sensitivity to missing/abnormal inputs tested (what happens with NaNs or sentinels at inference time?)"
      ],
      "verification": "Honest statement of where the model is reliable and where it degrades"
    },
    {
      "phase": 7,
      "name": "Deployment Readiness and Persistence",
      "checks": [
        "Model + ALL preprocessing artifacts saved together (encoders, scalers, feature order, threshold) in one bundle",
        "Reload-and-predict verified in a FRESH session using only the bundle",
        "Inference function accepts raw, human-readable inputs and handles validation errors with useful messages",
        "Latency and dependency footprint acceptable for the intended use (batch vs real-time)",
        "Version/tag recorded: model artifact, training data snapshot, code commit, random_state"
      ],
      "verification": "Three demo predictions (typical positive, typical negative, edge case) run correctly from the persisted bundle"
    },
    {
      "phase": 8,
      "name": "Reporting and Handover",
      "checks": [
        "Executive summary: problem, approach, headline metric, chosen operating point, one-paragraph limitation statement",
        "Visual dashboard: comparison chart, threshold sweep, confusion matrix at chosen threshold, feature importances",
        "Monitoring plan sketched: which metric to watch post-deployment (drift in feature distributions, recall degradation), retraining trigger defined",
        "Explicit usage disclaimer: domains like safety (mushrooms, aviation, medicine) require the model to remain decision support, never autonomous authority"
      ],
      "verification": "A stakeholder unfamiliar with the code could read the report and correctly state what the model does, when to trust it, and when NOT to"
    }
  ],
  "good_fit_vs_bad_fit_quick_reference": {
    "good_fit_signals": [
      "Rich labeled history exists; outcomes repeat with learnable patterns",
      "Inputs available at prediction time (nothing required that arrives only after the decision)",
      "Errors have quantifiable, tolerated-but-minimized costs",
      "Stakeholders will act on outputs; feedback loop exists to catch degradation",
      "Baseline rules perform poorly or are inconsistent across cases"
    ],
    "bad_fit_red_flags": [
      "No labels and no feasible way to get them",
      "Target depends on future information unavailable at prediction time (leaky by construction)",
      "Sample size too small per class; or problem deterministic — a rule suffices",
      "Environment shifts faster than retraining cycles (adversarial, viral, geopolitical shocks)",
      "Regulatory or ethical constraints require deterministic explainable decisions",
      "Prediction changes nothing — no decision, no action, no value"
    ],
    "reframing_options": [
      "Classification → anomaly detection when failures are too rare to label",
      "Classification → regression on time-to-event (RUL) when severity timing matters",
      "Supervised → semi-supervised or active labeling when labels are scarce but obtainable",
      "Fully automated decision → human-in-the-loop triage when error costs are asymmetric"
    ]
  },
  "universal_gotchas": [
    "Data leakage: any statistic computed on the full dataset before splitting (scalers, encoders, imputation values, rolling stats without grouping)",
    "Row-level splits on grouped/time-series data inflate scores — always split by entity or time",
    "Fitting preprocessing on test data — everything fit() must happen on train only, via Pipelines where possible",
    "Misreading predict_proba column order — always check clf.classes_",
    "Sentinel values (-999, '?', 999) silently corrupting means and splits",
    "Label leakage: features that contain the answer (post-outcome timestamps, 'resolution' fields)",
    "Tuning on the test set — that turns it into a second training set; use CV on train for selection",
    "Assuming class 1 = positive without checking encoder order",
    "Forgetting random_state → irreproducible results and non-repeatable debugging",
    "Deploying a model without its encoders/scalers — fresh transformers at inference break the feature mapping"
  ],
  "final_gate_question": "If the model were wrong on exactly one prediction tomorrow, which error would it be, what would it cost, and does my operating point minimize that risk? If you cannot answer this, the project is not finished."
}