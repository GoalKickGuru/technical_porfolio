    "---\n",
    "## Part 5: String Operations — Cleaning Messy Real-World Data\n",
    "\n",
    "**Reference:** *Vectorized String Operations* (03.10) — `.str` accessor"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Simulate dirty data from multiple sources ──\n",
    "dirty = pd.DataFrame({\n",
    "    'raw_country': ['United States','UNITED STATES','china','China ',' JAPAN ',\n",
    "                    'Germany','germany','France',' france','U.K.','uk','BRAZIL'],\n",
    "    'raw_sector':  ['Tech','TECH','manufacturing','Manufacturing ',\n",
    "                    'automotive','FINANCE','Finance','AGRICULTURE',\n",
    "                    'agri','services',' Services','TECH']\n",
    "})\n",
    "\n",
    "# 1. Strip whitespace and standardise casing\n",
    "dirty['country']  = dirty['raw_country'].str.strip().str.title()\n",
    "dirty['sector']   = dirty['raw_sector'].str.strip().str.lower()\n",
    "\n",
    "# 2. Unify aliases\n",
    "dirty['country'] = dirty['country'].replace({'U.K.':'UK'})\n",
    "print('▼ Standardised names:')\n",
    "print(dirty[['raw_country','country','sector']].drop_duplicates().to_string(index=False))\n",
    "\n",
    "# 3. Pattern matching — classify sectors into broad categories\n",
    "dirty['sector_group'] = np.where(\n",
    "    dirty['sector'].str.contains('tech'), 'Industry',\n",
    "    np.where(dirty['sector'].str.contains('auto|manuf'), 'Industry', 'Services')\n",
    ")\n",
    "print('\\n▼ Sector classification:')\n",
    "print(dirty[['sector','sector_group']].drop_duplicates().to_string(index=False))\n",
    "\n",
    "# 4. Map to ISO codes for international joins\n",
    "iso_map = {'United States':'US','China':'CN','Japan':'JP','Germany':'DE',\n",
    "           'France':'FR','UK':'GB','Brazil':'BR'}\n",
    "dirty['iso'] = dirty['country'].map(iso_map)\n",
    "print('\\n▼ ISO codes added:')\n",
    "print(dirty[['country','iso']].drop_duplicates().to_string(index=False))\n",
    "\n",
    "# 5. String lengths — detect anomalies (too short / too long)\n",
    "dirty['name_len'] = dirty['country'].str.len()\n",
    "print('\\n▼ Country name lengths (anomaly detection):')\n",
    "print(dirty[['country','name_len']].drop_duplicates().sort_values('name_len').to_string(index=False))"
   ]
  },
