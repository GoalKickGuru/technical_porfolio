    "---\n",
    "## Part 8: Synthesis — End-to-End Economic Dashboard"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def economic_dashboard(df):\n",
    "    '''Complete economic analysis pipeline producing decision-ready insights.'''\n",
    "    sep = '=' * 70\n",
    "    print(sep)\n",
    "    print('  GLOBAL ECONOMIC INDICATOR DASHBOARD')\n",
    "    print(sep)\n",
    "\n",
    "    # 1. Overview\n",
    "    print(f'\\n[1] DATA OVERVIEW')\n",
    "    print(f'  Countries: {df[\"country\"].nunique()}  |  Years: {df[\"year\"].min()}–{df[\"year\"].max()}  |  Records: {len(df)}')\n",
    "\n",
    "    # 2. Country ranking\n",
    "    print(f'\\n[2] GDP GROWTH RANKING (mean 2018–2023)')\n",
    "    ranking = df.groupby('country')['gdp_growth'].mean().sort_values(ascending=False)\n",
    "    for i, (c, v) in enumerate(ranking.items(), 1):\n",
    "        bar = '█' * int(v * 4) if v > 0 else '░' * int(abs(v) * 4)\n",
    "        print(f'  {i}. {c:10s} {v:+.2f}%  {bar}')\n",
    "\n",
    "    # 3. Misery Index ranking\n",
    "    print(f'\\n[3] MISERY INDEX RANKING (lower is better)')\n",
    "    misery = df.groupby('country')['misery_index'].mean().sort_values()\n",
    "    for c, v in misery.items():\n",
    "        print(f'  {c:10s} {v:5.2f}  {\"▓\" * int(v)}')\n",
    "\n",
    "    # 4. Volatility\n",
    "    print(f'\\n[4] ECONOMIC VOLATILITY (σ of GDP growth)')\n",
    "    vol = df.groupby('country')['gdp_growth'].std().sort_values(ascending=False)\n",
    "    for c, v in vol.items():\n",
    "        print(f'  {c:10s} σ = {v:.2f}  {\"▮\" * int(v * 5)}')\n",
    "\n",
    "    # 5. Continental comparison\n",
    "    print(f'\\n[5] CONTINENTAL COMPARISON')\n",
    "    cont = df.groupby('continent').agg({\n",
    "        'gdp_growth':'mean','unemployment':'mean','inflation':'mean','misery_index':'mean'\n",
    "    }).round(2)\n",
    "    print(cont.to_string())\n",
    "\n",
    "    # 6. Recession detection\n",
    "    recessions = df[df['gdp_growth'] < 0]\n",
    "    print(f'\\n[6] RECESSION EPISODES DETECTED: {len(recessions)}')\n",
    "    print(recessions[['country','year','gdp_growth']].sort_values('gdp_growth').to_string(index=False))\n",
    "\n",
    "    # 7. Trade balance summary\n",
    "    print(f'\\n[7] TRADE BALANCE SUMMARY')\n",
    "    trade = df.groupby('country')['trade_balance'].mean().sort_values(ascending=False)\n",
    "    for c, v in trade.items():\n",
    "        sign = 'Surplus' if v > 0 else 'Deficit'\n",
    "        print(f'  {c:10s} {v:+8.0f}B  {sign}')\n",
    "\n",
    "    print(f'\\n{sep}')\n",
    "    print('  Analysis complete. Results are export-ready.')\n",
    "    print(sep)\n",
    "\n",
    "    return {'ranking': ranking, 'misery': misery, 'volatility': vol,\n",
    "            'continents': cont, 'recessions': recessions}\n",
    "\n",
    "# Run the full pipeline\n",
    "dashboard = economic_dashboard(df_analysis)"
   ]
