    "---\n",
    "## Part 7: Performance — eval() & query() on Large Datasets\n",
    "\n",
    "**Reference:** *High-Performance Pandas* (03.12) — `eval()`, `query()`"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Synthetic large-scale trade dataset ──\n",
    "np.random.seed(42)\n",
    "N = 50_000\n",
    "big_df = pd.DataFrame({\n",
    "    'country':   np.random.choice(countries_list, N),\n",
    "    'year':      np.random.choice(range(2010, 2024), N),\n",
    "    'gdp_b':     np.random.uniform(500, 25000, N),\n",
    "    'pop_m':     np.random.uniform(10, 1400, N),\n",
    "    'exports_b': np.random.uniform(100, 10000, N),\n",
    "    'imports_b': np.random.uniform(100, 10000, N),\n",
    "})\n",
    "print(f'Dataset size: {len(big_df):,} rows | Memory: {big_df.memory_usage(deep=True).sum()/1e6:.1f} MB')\n",
    "\n",
    "# ── Traditional arithmetic ──\n",
    "big_df['trade_balance'] = big_df['exports_b'] - big_df['imports_b']\n",
    "big_df['gdp_per_capita'] = big_df['gdp_b'] * 1e3 / big_df['pop_m']\n",
    "big_df['trade_openness'] = (big_df['exports_b'] + big_df['imports_b']) / big_df['gdp_b']\n",
    "\n",
    "# ── eval() — string-expression evaluation (less temp memory) ──\n",
    "big_df2 = big_df.drop(columns=['trade_balance','gdp_per_capita','trade_openness']).copy()\n",
    "big_df2.eval('''\n",
    "    trade_balance  = exports_b - imports_b\n",
    "    gdp_per_capita = gdp_b * 1000 / pop_m\n",
    "    trade_openness = (exports_b + imports_b) / gdp_b\n",
    "''', inplace=True)\n",
    "print('\\n▼ eval() computed columns — sample:')\n",
    "print(big_df2.head().round(2).to_string(index=False))\n",
    "\n",
    "# ── query() — efficient boolean filtering ──\n",
    "threshold_gdp = 10_000\n",
    "min_openness  = 0.4\n",
    "result = big_df2.query('gdp_b > @threshold_gdp and trade_openness > @min_openness')\n",
    "print(f'\\n▼ query() filter: GDP > {threshold_gdp} and openness > {min_openness}')\n",
    "print(f'Records matched: {len(result):,}')\n",
    "print(result.groupby(\"country\").size().to_string())\n",
    "\n",
    "# ── Timing comparison ──\n",
    "import timeit\n",
    "trad_time = timeit.timeit(\n",
    "    lambda: big_df[(big_df['gdp_b']>10000) & (big_df['trade_openness']>0.4)],\n",
    "    number=100\n",
    ")\n",
    "query_time = timeit.timeit(\n",
    "    lambda: big_df.query('gdp_b > 10000 and trade_openness > 0.4'),\n",
    "    number=100\n",
    ")\n",
    "print(f'\\n▼ Timing (100 iterations each):')\n",
    "print(f'  Traditional boolean mask: {trad_time:.4f}s')\n",
    "print(f'  query():                 {query_time:.4f}s')\n",
    "print(f'  Speedup factor:           {trad_time/query_time:.2f}×')"
   ]
  },
