      "title": "Identify Odd Values",
      "discussion": "0s in Glucose, BloodPressure, SkinThickness, Insulin, BMI are invalid"
    },
    {
      "step": 9,
      "title": "Replace 0 with NaN",
      "code_template": "diabetes_data[['Glucose', 'BloodPressure', 'SkinThickness', 'Insulin', 'BMI']] = diabetes_data[['Glucose', 'BloodPressure', 'SkinThickness', 'Insulin', 'BMI']].replace(0, np.nan)"
    },
    {
      "step": 10,
      "title": "Count Missing Values After Replacement",
      "code_template": "print(diabetes_data.isnull().sum())"
    },
    {
      "step": 11,
      "title": "Inspect Rows with Missing Data",
      "code_template": "print(diabetes_data[diabetes_data.isnull().any(axis=1)])"
