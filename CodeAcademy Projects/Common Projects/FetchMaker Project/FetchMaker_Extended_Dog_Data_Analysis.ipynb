    "script_content": "#!/usr/bin/env python3\n\"\"\"\nFetchMaker Extended Dog Data Analysis Script\nVersion 2.0\nAuthor: Lumo AI Assistant\nDate: 2026-07-25\n\nComplete script running all analyses from the extended project guide.\nRequires: pandas, numpy, scipy, statsmodels, matplotlib, seaborn, scikit-learn\n\"\"\"\n\n# ============================================================================\n# IMPORT LIBRARIES\n# ============================================================================\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom scipy import stats\nfrom scipy.stats import f_oneway, kruskal, binomtest\nfrom statsmodels.stats.multicomp import pairwise_tukeyhsd\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import classification_report\nfrom sklearn.preprocessing import LabelEncoder\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Set style for consistent visualizations\nplt.style.use('default')\nsns.set_palette('colorblind')\n\nprint(\"Fetching data...\")\nprint(\"=\" * 60)\n\n# ============================================================================\n# PART 1: LOAD AND INSPECT DATA\n# ============================================================================\ndtype_spec = {\n    'is_rescue': 'int8',\n    'weight': 'int16',\n    'tail_length': 'float32',\n    'age': 'int8',\n    'likes_children': 'int8',\n    'is_hypoallergenic': 'int8'\n}\n\ndogs = pd.read_csv('dog_data.csv', dtype=dtype_spec)\n\nprint(\"\\nDATASET OVERVIEW\")\nprint(\"=\" * 60)\nprint(f\"Total records: {len(dogs):,}\")\nprint(f\"Breeds: {dogs['breed'].nunique()} ({', '.join(sorted(dogs['breed'].unique()))})\")\nprint(f\"\\nColumn types:\\n{dogs.dtypes}\")\nprint(f\"\\nMissing values:\\n{dogs.isnull().sum()[dogs.isnull().sum() > 0]}\")\n\nbreed_counts = dogs['breed'].value_counts().sort_values(ascending=False)\nprint(\"\\nBreeds by frequency:\")\nfor breed, count in breed_counts.items():\n    pct = count / len(dogs) * 100\n    print(f\"  {breed.capitalize()}: {count} ({pct:.1f}%)\")\n\n# ============================================================================\n# PART 2: RESCUE RATE ANALYSIS\n# ============================================================================\ndef analyze_rescue_rates(df, breed=None, population_rate=0.08):\n    if breed:\n        df = df[df['breed'] == breed]\n    rescue_stats = df.groupby('breed').agg({'is_rescue': ['count', 'sum']})\n    rescue_stats.columns = ['total_dogs', 'num_rescues']\n    rescue_stats['rescue_rate'] = rescue_stats['num_rescues'] / rescue_stats['total_dogs']\n    rescue_stats['diff_from_expected'] = rescue_stats['rescue_rate'] - population_rate\n    rescue_stats['ci_lower'], rescue_stats['ci_upper'] = zip(*[\n        stats.beta.interval(0.95, int(sum_rescues), int(total_dogs - sum_rescues + 1))\n        for sum_rescues, total_dogs in zip(rescue_stats['num_rescues'], rescue_stats['total_dogs'])\n    ])\n    pvals = []\n    for _, row in rescue_stats.iterrows():\n        test_result = binomtest(int(row['num_rescues']), int(row['total_dogs']), population_rate, alternative='two-sided')\n        pvals.append(test_result.pvalue)\n    rescue_stats['p_value'] = pvals\n    rescue_stats['significant_at_0.05'] = rescue_stats['p_value'] < 0.05\n    return rescue_stats.sort_values('rescue_rate', ascending=False)\n\nrescue_analysis = analyze_rescue_rates(dogs)\nprint(\"\\nRESCUE RATE ANALYSIS BY BREED (vs 8% baseline)\")\nprint(\"=\" * 70)\nprint(rescue_analysis[['rescue_rate', 'diff_from_expected', 'p_value', 'significant_at_0.05']].round(3))\n\n# ============================================================================\n# PART 3: WEIGHT ANALYSIS & VISUALIZATION\n# ============================================================================\nweight_by_breed = dogs.groupby('breed')['weight'].agg(['count', 'mean', 'std', 'min', 'median', 'max']).round(2)\nprint(\"\\nWEIGHT STATISTICS BY BREED\")\nprint(\"=\" * 70)\nprint(weight_by_breed.to_string())\n\nfig, axes = plt.subplots(2, 2, figsize=(14, 10))\nfig.suptitle('Weight Distribution Across All Breeds', fontsize=16, fontweight='bold')\nsns.boxplot(data=dogs, x='breed', y='weight', ax=axes[0, 0])\naxes[0, 0].set_title('Boxplot: Weight by Breed', fontweight='bold')\naxes[0, 0].tick_params(axis='x', rotation=45)\naxes[0, 0].axhline(y=dogs['weight'].mean(), color='red', linestyle='--', label=f'Mean: {dogs[\"weight\"].mean():.1f} lbs')\naxes[0, 0].legend()\n\nbreeds_of_interest = ['whippet', 'terrier', 'pitbull']\nsubset_weights = dogs[dogs['breed'].isin(breeds_of_interest)]\nsns.boxplot(data=subset_weights, x='breed', y='weight', ax=axes[0, 1], order=breeds_of_interest)\naxes[0, 1].set_title('Weight Comparison: Whippet vs Terrier vs Pitbull', fontweight='bold')\naxes[0, 1].tick_params(axis='x', rotation=0)\n\ncolors = {'whippet': '#6d4aff', 'terrier': '#ff6d4a', 'pitbull': '#4a6dff'}\naxes[1, 0].hist(subset_weights[subset_weights['breed']=='whippet']['weight'], bins=15, alpha=0.6, color=colors['whippet'], label='Whippet', density=True)\naxes[1, 0].hist(subset_weights[subset_weights['breed']=='terrier']['weight'], bins=15, alpha=0.6, color=colors['terrier'], label='Terrier', density=True)\naxes[1, 0].hist(subset_weights[subset_weights['breed']=='pitbull']['weight'], bins=15, alpha=0.6, color=colors['pitbull'], label='Pitbull', density=True)\naxes[1, 0].set_title('Weight Density Comparison', fontweight='bold')\naxes[1, 0].legend()\naxes[1, 0].axvline(x=subset_weights['weight'].mean(), color='gray', linestyle=':')\n\nnumeric_cols = ['weight', 'tail_length', 'age']\ncorr_matrix = dogs[numeric_cols].corr()\nim = axes[1, 1].imshow(corr_matrix, cmap='Blues', aspect='auto')\naxes[1, 1].set_xticks(range(len(numeric_cols)))\naxes[1, 1].set_yticks(range(len(numeric_cols)))\naxes[1, 1].set_xticklabels(numeric_cols)\naxes[1, 1].set_yticklabels(numeric_cols)\naxes[1, 1].set_title('Correlation Matrix', fontweight='bold')\naxes[1, 1].legend([], [], frameon=False)\nfor i in range(len(numeric_cols)):\n    for j in range(len(numeric_cols)):\n        axes[1, 1].text(j, i, f'{corr_matrix.iloc[i, j]:.2f}', ha='center', va='center')\n\nplt.tight_layout()\nplt.savefig('fetchmaker_weight_analysis.png', dpi=150, bbox_inches='tight')\nprint(\"\\n✓ Visualization saved to fetchmaker_weight_analysis.png\")\n\n# ============================================================================\n# PART 4: ANOVA & POST-HOC TESTING\n# ============================================================================\ndef comprehensive_weight_comparison(df, breed_list=None):\n    if breed_list is None:\n        breed_list = ['whippet', 'terrier', 'pitbull']\n    subset = df[df['breed'].isin(breed_list)]\n    print(\"\\n\" + \"=\" * 60)\n    print(\"ASSUMPTION CHECKING FOR WEIGHT COMPARISON\")\n    print(\"=\" * 60)\n    weights_by_breed = [subset[subset['breed']==breed]['weight'] for breed in breed_list]\n    print(\"\\nNormality Tests (Shapiro-Wilk):\")\n    for breed, w_group in zip(breed_list, weights_by_breed):\n        stat, p = stats.shapiro(w_group)\n        print(f\"  {breed.capitalize()}: W={stat:.3f}, p={p:.3f} {'✓ Normal' if p > 0.05 else '✗ Non-normal'}\")\n    levene_stat, levene_p = stats.levene(*weights_by_breed)\n    print(f\"\\nHomogeneity of Variance (Levene's):\")\n    print(f\"  Statistic: {levene_stat:.3f}, p={levene_p:.3f} {'✓ Equal variance' if levene_p > 0.05 else '✗ Unequal variance'}\")\n    print(\"\\n\" + \"=\" * 60)\n    print(\"HYPOTHESIS TESTING RESULTS\")\n    print(\"=\" * 60)\n    F_stat, p_anova = f_oneway(*weights_by_breed)\n    print(f\"\\nOne-way ANOVA:\")\n    print(f\"  F-statistic: {F_stat:.3f}\")\n    print(f\"  p-value: {p_anova:.6f}\")\n    print(f\"  Conclusion: {'Significant difference' if p_anova < 0.05 else 'No significant difference'} (α=0.05)\")\n    kw_stat, p_kruskal = kruskal(*weights_by_breed)\n    print(f\"\\nKruskal-Wallis (non-parametric):\")\n    print(f\"  H-statistic: {kw_stat:.3f}\")\n    print(f\"  p-value: {p_kruskal:.6f}\")\n    print(\"\\nTukey HSD Post-Hoc Test (pairwise comparisons):\")\n    dogs_subset = subset.copy()\n    tukey_results = pairwise_tukeyhsd(endog=dogs_subset['weight'], groups=dogs_subset['breed'], alpha=0.05)\n    print(tukey_results.summary())\n    return {'anova_f': F_stat, 'anova_p': p_anova, 'kruskal_h': kw_stat, 'kruskal_p': p_kruskal, 'tukey_results': tukey_results}\n\nresults = comprehensive_weight_comparison(dogs, ['whippet', 'terrier', 'pitbull'])\np_anova = results['anova_p']\n\n# ============================================================================\n# PART 5: COLOR ASSOCIATION ANALYSIS\n# ============================================================================\ndef analyze_color_breed_association(df, target_breeds=None):\n    if target_breeds:\n        df_subset = df[df['breed'].isin(target_breeds)]\n    else:\n        df_subset = df.copy()\n    contingency = pd.crosstab(df_subset['color'], df_subset['breed'])\n    chi2_stat, p_val, dof, expected = stats.chi2_contingency(contingency)\n    n = df_subset.shape[0]\n    min_dim = min(contingency.shape) - 1\n    cramer_v = np.sqrt(chi2_stat / (n * min_dim))\n    print(\"\\n\" + \"=\" * 60)\n    print(\"BREED-COLOR ASSOCIATION ANALYSIS\")\n    print(\"=\" * 60)\n    print(f\"\\nContingency Table Shape: {contingency.shape}\")\n    print(f\"\\nChi-square statistic: {chi2_stat:.3f}\")\n    print(f\"Degrees of freedom: {dof}\")\n    print(f\"P-value: {p_val:.6f}\")\n    print(f\"Cramer's V (effect size): {cramer_v:.3f}\")\n    print(f\"Interpretation: {'Strong' if cramer_v > 0.3 else 'Moderate' if cramer_v > 0.1 else 'Weak'} association\")\n    print(f\"\\nConclusion: {'Color differs significantly by breed' if p_val < 0.05 else 'No significant color-breed association'} (α=0.05)\")\n    return contingency, chi2_stat, p_val, cramer_v\n\nprint(\"\\nPART 1: Original Analysis (Poodle vs Shihtzu)\")\ncontingency_ps, chi2_ps, p_ps, cv_ps = analyze_color_breed_association(dogs, ['poodle', 'shihtzu'])\nprint(\"\\n\\nPART 2: All Breeds Analysis\")\ncontingency_all, chi2_all, p_all, cv_all = analyze_color_breed_association(dogs)\nprint(\"\\n\\nCOLOR DISTRIBUTION BY BREED (% within breed)\")\ncolor_pct = contingency_all.div(contingency_all.sum(axis=0), axis=1) * 100\nprint(color_pct.round(1).to_string())\n\n# ============================================================================\n# PART 6A: AGE DISTRIBUTION ANALYSIS\n# ============================================================================\nprint(\"\\n\" + \"=\" * 60)\nprint(\"AGE DISTRIBUTION ANALYSIS\")\nprint(\"=\" * 60)\nbreed_order = dogs['breed'].value_counts().index.tolist()\nfig, axes = plt.subplots(1, 2, figsize=(12, 5))\nsns.histplot(data=dogs, x='age', hue='breed', kde=True, ax=axes[0], bins=range(15))\naxes[0].set_title('Age Distribution by Breed', fontweight='bold')\naxes[0].set_xlabel('Age (years)')\nsns.boxplot(data=dogs, x='breed', y='age', ax=axes[1], order=breed_order)\naxes[1].set_title('Age Statistics by Breed', fontweight='bold')\naxes[1].tick_params(axis='x', rotation=45)\nplt.tight_layout()\nplt.savefig('fetchmaker_age_analysis.png', dpi=150, bbox_inches='tight')\nprint(\"\\nAge Comparison Between Breeds (Kruskal-Wallis Test)\")\nage_groups = [dogs[dogs['breed']==b]['age'] for b in breed_order[:5]]  # Top 5 for speed\nkw_stat, kw_p = stats.kruskal(*age_groups)\nprint(f\"H-statistic: {kw_stat:.3f}, p-value: {kw_p:.6f}\")\n\n# ============================================================================\n# PART 6B: HYPOALLERGENIC ANALYSIS\n# ============================================================================\nprint(\"\\n\" + \"=\" * 60)\nprint(\"HYPOALLERGENIC STATUS BY BREED\")\nprint(\"=\" * 60)\nhypoallergenic_analysis = dogs.groupby('breed').agg({'is_hypoallergenic': ['count', 'sum']}).round(2)\nhypoallergenic_analysis.columns = ['total', 'hypallergenic_count']\nhypoallergenic_analysis['hypoallergenic_pct'] = (hypoallergenic_analysis['hypallergenic_count'] / hypoallergenic_analysis['total'] * 100).round(1)\nprint(hypoallergenic_analysis.sort_values('hypoallergenic_pct', ascending=False).to_string())\ncontingency_hyp_rescue = pd.crosstab(dogs['is_hypoallergenic'], dogs['is_rescue'])\nchi2_hyp, p_hyp, dof_hyp, exp_hyp = stats.chi2_contingency(contingency_hyp_rescue)\nprint(f\"\\nHypoallergenic vs Rescue Relationship:\")\nprint(f\"Chi-square: {chi2_hyp:.3f}, p-value: {p_hyp:.4f}\")\n\n# ============================================================================\n# PART 6C: CHILD-FRIENDLY ANALYSIS\n# ============================================================================\nprint(\"\\n\" + \"=\" * 60)\nprint(\"CHILD-FRIENDLINESS SCORE BY BREED (0-1)\")\nprint(\"=\" * 60)\nchild_friendly = dogs.groupby('breed').agg({'likes_children': 'mean'}).rename(columns={'likes_children': 'child_friendly_score'})\nprint(child_friendly.sort_values('child_friendly_score', ascending=False).round(3).to_string())\n\n# ============================================================================\n# PART 7: MACHINE LEARNING\n# ============================================================================\nprint(\"\\n\" + \"=\" * 60)\nprint(\"BREED PREDICTION MODEL (Random Forest)\")\nprint(\"=\" * 60)\ncolor_encoder = LabelEncoder()\ndogs['color_encoded'] = color_encoder.fit_transform(dogs['color'])\nfeatures = dogs[['weight', 'tail_length', 'age', 'color_encoded']]\ntarget = dogs['breed']\nX_train, X_test, y_train, y_test = train_test_split(features, target, test_size=0.2, random_state=42, stratify=target)\nmodel = RandomForestClassifier(n_estimators=100, random_state=42)\nmodel.fit(X_train, y_train)\npredictions = model.predict(X_test)\naccuracy = (predictions == y_test).mean()\nprint(f\"Accuracy: {accuracy:.2%}\")\nprint(\"\\nFeature Importance:\")\nimportance_df = pd.DataFrame({'feature': features.columns, 'importance': model.feature_importances_}).sort_values('importance', ascending=False)\nprint(importance_df.to_string(index=False))\nprint(\"\\nClassification Report:\")\nprint(classification_report(y_test, predictions))\n\n# ============================================================================\n# PART 8: EXECUTIVE SUMMARY\n# ============================================================================\nprint(\"\\n\" + \"=\" * 70)\nprint(\"FETCHMAKER DATA ANALYSIS - EXECUTIVE SUMMARY\")\nprint(\"=\" * 70)\nfindings = [\n    (\"Dataset Size\", f\"{len(dogs):,} dogs across {dogs['breed'].nunique()} breeds\"),\n    (\"Most Common Breed\", f\"{breed_counts.index[0].capitalize()} ({breed_counts.iloc[0]} dogs)\"),\n    (\"Average Weight\", f\"{dogs['weight'].mean():.1f} lbs (±{dogs['weight'].std():.1f})\"),\n    (\"Overall Rescue Rate\", f\"{dogs['is_rescue'].mean()*100:.1f}% (vs 8% baseline)\"),\n    (\"Hypoallergenic Breeds\", f\"{dogs['is_hypoallergenic'].mean()*100:.1f}% of all dogs\"),\n    (\"Child-Friendly Breeds\", f\"{dogs['likes_children'].mean()*100:.1f}% prefer children\"),\n    (\"Color-Breed Association\", f\"{'Significant' if p_all < 0.05 else 'Not significant'} (χ²={chi2_all:.1f}, p={p_all:.4f})\"),\n    (\"Weight Differences\", f\"{'Significant' if p_anova < 0.05 else 'Not significant'} across breeds (ANOVA, p={p_anova:.4f})\")\n]\nfor title, value in findings:\n    print(f\"• {title:.<50} {value}\")\nprint(\"\\n\" + \"=\" * 70)\nprint(\"\\nAnalysis complete! Check generated PNG files for visualizations.\")",
    "file_name": "fetchmaker_complete_analysis.py"
  }
}