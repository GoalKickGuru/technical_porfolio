  "quick_reference_appendix": {
    "common_formulas": {
      "arc_elasticity": "(ΔQ/Q_avg) / (ΔP/P_avg)",
      "cohen_h": "2 × (arcsin√p₁ - arcsin√p₂)",
      "required_sales": "target_revenue / price",
      "required_conversion": "required_sales / traffic",
      "family_wise_error": "1 - (1 - α)^n_tests"
    },
    "interpretation_guide": {
      "cohen_h_interpretation": {
        "<0.2": "negligible",
        "0.2-0.5": "small",
        "0.5-0.8": "medium",
        ">0.8": "large"
      },
      "elasticity_interpretation": {
        "|ε| > 1": "Elastic - lower price increases revenue",
        "|ε| < 1": "Inelastic - raise price increases revenue",
        "|ε| ≈ 1": "Unit elastic - revenue maximized"
      },
      "confidence_interval_decisions": {
        "CI_below_target": "Fails threshold",
        "CI_straddles_target": "Uncertain - collect more data",
        "CI_above_target": "Strong evidence of success"
      }
    },
