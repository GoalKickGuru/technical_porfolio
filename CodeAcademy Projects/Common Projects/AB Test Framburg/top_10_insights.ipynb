      "code_snippet": "from scipy import stats\n\n# Balance check on pre-treatment covariates\nfor covariate in ['session_length', 'prior_visits', 'device_type']:\n    grps = [df[df['group']==g][covariate] for g in ['A','B','C']]\n    f_stat, p_val = stats.f_oneway(*grps) if covariate.numeric \n                  else stats.chi2_contingency(pd.crosstab(df['group'], covariate))[1]\n    print(f'{covariate}: p={p_val:.4f} → {\"BALANCED\" if p_val>0.05 else \"IMBALANCED\"}')",
