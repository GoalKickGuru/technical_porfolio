    "content": "# ==============================================================================\n# ALGERIAN FOREST FIRES - EXTENDED ANALYSIS (PART 3 of 3)\n# Sections: Logistic Regression, Random Forest, FWI, Final Summary, Output\n# Requires: forests DataFrame from Parts 1-2\n# ==============================================================================\n\n# ==============================================================================\n# SECTION 9: LOGISTIC REGRESSION - FIRE CLASSIFICATION\n# ==============================================================================\nprint('\\n' + '=' * 80)\nprint('FIRE CLASSIFICATION - LOGISTIC REGRESSION')\nprint('=' * 80)\n\nfeatures = ['temp', 'humid', 'wind', 'rain', 'FFMC', 'ISI', 'BUI', 'FWI', 'DMC', 'DC']\nX = forests[features]\ny = forests['fire_binary']\n\nscaler = StandardScaler()\nX_scaled = pd.DataFrame(scaler.fit_transform(X), columns=features)\n\nX_train, X_test, y_train, y_test = train_test_split(\n    X_scaled, y, test_size=0.2, random_state=42, stratify=y\n)\n\nprint(f'Training: {len(X_train)} | Testing: {len(X_test)}')\nprint(f'Train classes: {y_train.value_counts().to_dict()}')\nprint(f'Test classes:  {y_test.value_counts().to_dict()}')\n\n# Logistic Regression\nlog_model = LogisticRegression(max_iter=1000, penalty='l2', C=1.0)\nlog_model.fit(X_train, y_train)\ny_pred_log = log_model.predict(X_test)\ny_proba_log = log_model.predict_proba(X_test)[:, 1]\n\nprint('\\n' + '-' * 80)\nprint('LOGISTIC REGRESSION RESULTS')\nprint('-' * 80)\nprint(classification_report(y_test, y_pred_log, target_names=['No Fire', 'Fire']))\n\ncm_log = confusion_matrix(y_test, y_pred_log)\nprint(f'Confusion Matrix:\\n{cm_log}')\nprint(f'Accuracy: {(cm_log.diagonal().sum() / cm_log.sum()):.3f}')\nprint(f'ROC-AUC:  {roc_auc_score(y_test, y_proba_log):.3f}')\n\n# Feature coefficients\nlog_coeffs = pd.DataFrame({\n    'Feature': features,\n    'Coefficient': log_model.coef_[0],\n    'Odds_Ratio': np.exp(log_model.coef_[0])\n}).sort_values('Coefficient', ascending=False)\n\nprint('\\n' + '-' * 80)\nprint('LOGISTIC REGRESSION COEFFICIENTS (sorted by influence)')\nprint('-' * 80)\nprint(log_coeffs.to_string(index=False))\n\nprint('\\nPositive coefficients INCREASE fire risk.')\nprint('Negative coefficients DECREASE fire risk.')\n\n# ==============================================================================\n# SECTION 9b: RANDOM FOREST CLASSIFIER\n# ==============================================================================\nprint('\\n' + '=' * 80)\nprint('FIRE CLASSIFICATION - RANDOM FOREST')\nprint('=' * 80)\n\nrf_model = RandomForestClassifier(n_estimators=200, max_depth=6, random_state=42)\nrf_model.fit(X_train, y_train)\ny_pred_rf = rf_model.predict(X_test)\ny_proba_rf = rf_model.predict_proba(X_test)[:, 1]\n\nprint('\\n' + '-' * 80)\nprint('RANDOM FOREST RESULTS')\nprint('-' * 80)\nprint(classification_report(y_test, y_pred_rf, target_names=['No Fire', 'Fire']))\n\ncm_rf = confusion_matrix(y_test, y_pred_rf)\nprint(f'Confusion Matrix:\\n{cm_rf}')\nprint(f'Accuracy: {(cm_rf.diagonal().sum() / cm_rf.sum()):.3f}')\nprint(f'ROC-AUC:  {roc_auc_score(y_test, y_proba_rf):.3f}')\n\nrf_importance = pd.DataFrame({\n    'Feature': features,\n    'Importance': rf_model.feature_importances_\n}).sort_values('Importance', ascending=False)\n\nprint('\\n' + '-' * 80)\nprint('RANDOM FOREST FEATURE IMPORTANCE')\nprint('-' * 80)\nprint(rf_importance.to_string(index=False))\n\n# ==============================================================================\n# SECTION 9c: CLASSIFICATION VISUALIZATIONS\n# ==============================================================================\nprint('\\n' + '=' * 80)\nprint('GENERATING CLASSIFICATION VISUALIZATIONS')\nprint('=' * 80)\n\n# Confusion matrices side by side\nfig, axes = plt.subplots(1, 2, figsize=(14, 6))\n\nim1 = axes[0].imshow(cm_log, cmap='Blues', interpolation='nearest')\naxes[0].set_title('Logistic Regression\\nConfusion Matrix', fontweight='bold')\naxes[0].set_xticks([0, 1]); axes[0].set_yticks([0, 1])\naxes[0].set_xticklabels(['No Fire', 'Fire'])\naxes[0].set_yticklabels(['No Fire', 'Fire'])\nfor i in range(2):\n    for j in range(2):\n        axes[0].text(j, i, str(cm_log[i, j]), ha='center', va='center', fontsize=16, fontweight='bold', color='darkblue')\nplt.colorbar(im1, ax=axes[0], shrink=0.8)\n\nim2 = axes[1].imshow(cm_rf, cmap='Oranges', interpolation='nearest')\naxes[1].set_title('Random Forest\\nConfusion Matrix', fontweight='bold')\naxes[1].set_xticks([0, 1]); axes[1].set_yticks([0, 1])\naxes[1].set_xticklabels(['No Fire', 'Fire'])\naxes[1].set_yticklabels(['No Fire', 'Fire'])\nfor i in range(2):\n    for j in range(2):\n        axes[1].text(j, i, str(cm_rf[i, j]), ha='center', va='center', fontsize=16, fontweight='bold', color='darkred')\nplt.colorbar(im2, ax=axes[1], shrink=0.8)\n\nplt.suptitle('Classification Model Comparison', fontsize=16, fontweight='bold')\nplt.tight_layout()\nplt.savefig('fig10_confusion_matrices.png', dpi=300, bbox_inches='tight')\nprint('  Saved: fig10_confusion_matrices.png')\nplt.close()\n\n# Feature importance bar chart\nfig, ax = plt.subplots(figsize=(12, 8))\nimp_sorted = rf_importance.sort_values('Importance')\ncolors = ['#ff6b35' if imp > 0.1 else '#6d4aff' for imp in imp_sorted['Importance']]\nbars = ax.barh(imp_sorted['Feature'], imp_sorted['Importance'], color=colors)\nax.set_xlabel('Feature Importance', fontsize=12)\nax.set_title('Random Forest Feature Importances', fontsize=16, fontweight='bold')\nfor bar, imp in zip(bars, imp_sorted['Importance']):\n    ax.text(imp + 0.01, bar.get_y() + bar.get_height() / 2, f'{imp:.3f}', va='center', fontsize=9)\nplt.savefig('fig11_rf_feature_importance.png', dpi=300, bbox_inches='tight')\nprint('  Saved: fig11_rf_feature_importance.png')\nplt.close()\n\n# Logistic coefficients chart\nfig, ax = plt.subplots(figsize=(12, 8))\nlc_sorted = log_coeffs.sort_values('Coefficient')\ncolors_lc = ['#ff6b35' if c > 0 else '#6d4aff' for c in lc_sorted['Coefficient']]\nbars = ax.barh(lc_sorted['Feature'], lc_sorted['Coefficient'], color=colors_lc)\nax.axvline(x=0, color='black', linewidth=1)\nax.set_xlabel('Coefficient (log-odds scale)', fontsize=12)\nax.set_title('Logistic Regression Coefficients - Fire Risk Factors', fontsize=16, fontweight='bold')\nfor bar, coef in zip(bars, lc_sorted['Coefficient']):\n    ax.text(coef + (0.1 if coef > 0 else -0.1), bar.get_y() + bar.get_height() / 2,\n           f'{coef:.2f}', va='center', ha='left' if coef > 0 else 'right', fontsize=10)\nplt.savefig('fig12_logistic_coefficients.png', dpi=300, bbox_inches='tight')\nprint('  Saved: fig12_logistic_coefficients.png')\nplt.close()\n\n# ==============================================================================\n# SECTION 10: MODEL COMPARISON SUMMARY TABLE\n# ==============================================================================\nprint('\\n' + '=' * 80)\nprint('MODEL COMPARISON SUMMARY')\nprint('=' * 80)\n\ncomparison = pd.DataFrame({\n    'Metric': ['Accuracy', 'ROC-AUC', 'Precision (Fire)', 'Recall (Fire)', 'F1 (Fire)'],\n    'Logistic Regression': [\n        (cm_log.diagonal().sum() / cm_log.sum()),\n        roc_auc_score(y_test, y_proba_log),\n        classification_report(y_test, y_pred_log, output_dict=True)['Fire']['precision'],\n        classification_report(y_test, y_pred_log, output_dict=True)['Fire']['recall'],\n        classification_report(y_test, y_pred_log, output_dict=True)['Fire']['f1-score']\n    ],\n    'Random Forest': [\n        (cm_rf.diagonal().sum() / cm_rf.sum()),\n        roc_auc_score(y_test, y_proba_rf),\n        classification_report(y_test, y_pred_rf, output_dict=True)['Fire']['precision'],\n        classification_report(y_test, y_pred_rf, output_dict=True)['Fire']['recall'],\n        classification_report(y_test, y_pred_rf, output_dict=True)['Fire']['f1-score']\n    ]\n})\nprint(comparison.round(3).to_string(index=False))\n\n# ==============================================================================\n# SECTION 11: SAVE ALL OUTPUTS\n# ==============================================================================\nprint('\\n' + '=' * 80)\nprint('SAVING OUTPUT FILES')\nprint('=' * 80)\n\n# Save processed data\nforests.to_csv('forests_processed.csv', index=False)\nprint('  Saved: forests_processed.csv')\n\n# Save model coefficients\nmodel_output = {\n    'humidity_model': {k: round(float(v), 4) for k, v in modelH.params.items()},\n    'humidity_model_r_squared': round(float(modelH.rsquared), 4),\n    'interaction_model': {k: round(float(v), 4) for k, v in modelF.params.items()},\n    'interaction_model_r_squared': round(float(modelF.rsquared), 4),\n    'polynomial_model': {k: round(float(v), 4) for k, v in modelP.params.items()},\n    'polynomial_model_r_squared': round(float(modelP.rsquared), 4),\n    'fwi_model': {k: round(float(v), 4) for k, v in modelFWI.params.items()},\n    'fwi_model_r_squared': round(float(modelFWI.rsquared), 4),\n    'ffmc_weather_model': {k: round(float(v), 4) for k, v in modelFFMC.params.items()},\n    'ffmc_weather_model_r_squared': round(float(modelFFMC.rsquared), 4),\n    'logistic_coefficients': log_coeffs.to_dict(orient='records'),\n    'random_forest_importance': rf_importance.to_dict(orient='records'),\n    'classification_comparison': comparison.to_dict(orient='records')\n}\n\nwith open('model_outputs.json', 'w') as f:\n    json.dump(model_output, f, indent=2)\nprint('  Saved: model_outputs.json')\n\nprint('\\nAll output files:')\nprint('  1.  fig1_regional_boxplots.png')\nprint('  2.  fig2_humidity_temperature_region.png')\nprint('  3.  fig3_correlation_heatmap.png')\nprint('  4.  fig4_fire_nofire_distributions.png')\nprint('  5.  fig5_pairplot_fire_status.png')\nprint('  6.  fig6_humidity_diagnostics.png')\nprint('  7.  fig7_humidity_regression_lines.png')\nprint('  8.  fig8_ffmc_interaction.png')\nprint('  9.  fig9_ffmc_quadratic.png')\nprint('  10. fig10_confusion_matrices.png')\nprint('  11. fig11_