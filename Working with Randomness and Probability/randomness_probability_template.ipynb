    "<a id='bayes'></a>\n",
    "## 5. Bayesian Updating (Beta-Binomial)\n",
    "\n",
    "Conjugate-prior framework for proportion/conversion-rate problems."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class BetaBinomialUpdater:\n",
    "    \"\"\"Track and update a Beta(α, β) prior with binomial observations.\n",
    "    \n",
    "    Usage:\n",
    "        bb = BetaBinomialUpdater(alpha=25, beta_param=75)\n",
    "        bb.update(successes=122, failures=257)\n",
    "        bb.plot(threshold=0.33)\n",
    "    \"\"\"\n",
    "    def __init__(self, alpha=1, beta_param=1):\n",
    "        self.history = [(alpha, beta_param)]\n",
    "    \n",
    "    @property\n",
    "    def alpha(self):       return self.history[-1][0]\n",
    "    @property\n",
    "    def beta_param(self):  return self.history[-1][1]\n",
    "    @property\n",
    "    def mean(self):        return self.alpha / (self.alpha + self.beta_param)\n",
    "    @property\n",
    "    def mode(self):\n",
    "        a, b = self.alpha, self.beta_param\n",
    "        return (a - 1) / (a + b - 2) if a > 1 and b > 1 else np.nan\n",
    "    \n",
    "    def update(self, successes, failures):\n",
    "        a_new = self.alpha + successes\n",
    "        b_new = self.beta_param + failures\n",
    "        self.history.append((a_new, b_new))\n",
    "    \n",
    "    def prob_above(self, threshold):\n",
    "        return sp.integrate.quad(\n",
    "            beta_dist.pdf, threshold, 1, args=(self.alpha, self.beta_param)\n",
    "        )[0]\n",
    "    \n",
    "    def credible_interval(self, cred=0.95):\n",
    "        lower = (1 - cred) / 2\n",
    "        upper = 1 - lower\n",
    "        return beta_dist.ppf(lower, self.alpha, self.beta_param), \\\n",
    "               beta_dist.ppf(upper, self.alpha, self.beta_param)\n",
    "    \n",
    "    def plot(self, threshold=None, p_range=None):\n",
    "        p = np.linspace(0, 1, 500) if p_range is None else np.linspace(*p_range, 500)\n",
    "        fig, ax = plt.subplots(figsize=FIG_SIZE)\n",
    "        cmap = plt.cm.coolwarm(np.linspace(0, 1, len(self.history)))\n",
    "        for i, (a, b) in enumerate(self.history):\n",
    "            label = f\"α={a},β={b}\" if i == 0 else f\"Update {i}: α={a},β={b}\"\n",
    "            ls = \"--\" if i == 0 else \"-\"\n",
    "            ax.plot(p, beta_dist.pdf(p, a, b), ls=ls, color=cmap[i], lw=1.5, label=label)\n",
    "        if threshold is not None:\n",
    "            ax.axvline(threshold, color=\"red\", ls=\":\", label=f\"Threshold {threshold}\")\n",
    "        ax.set_xlabel(\"Success rate\"); ax.set_ylabel(\"Density\")\n",
    "        ax.set_title(\"Bayesian Evolution of Beta Distribution\")\n",
    "        ax.legend(fontsize=8)\n",
    "        plt.tight_layout(); plt.show()\n",
    "    \n",
    "    def summary(self):\n",
    "        lo, hi = self.credible_interval()\n",
    "        return {\n",
    "            \"alpha\": self.alpha,\n",
    "            \"beta\": self.beta_param,\n",
    "            \"mean\": self.mean,\n",
    "            \"mode\": self.mode,\n",
    "            \"95% CI\": (lo, hi),\n",
    "        }\n",
    "\n",
    "# ── example ────────────────────────────────────────────────────────\n",
    "bb = BetaBinomialUpdater(alpha=25, beta_param=75)\n",
    "bb.update(successes=122, failures=257)\n",
    "bb.plot(threshold=0.33)\n",
    "for k, v in bb.summary().items():\n",
    "    print(f\"{k:>8}: {v}\")"
   ]
  },
