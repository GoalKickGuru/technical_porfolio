   "source": [
    "<a id='mc'></a>\n",
    "## 6. Monte Carlo & MCMC (PyMC)\n",
    "\n",
    "Generic helper for estimating polynomial-model parameters and a Monte-Carlo integration utility."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def monte_carlo_integral(func, a, b, n=100_000, rng=rng):\n",
    "    \"\"\"Estimate ∫ₐᵇ f(x) dx via crude Monte Carlo.\n",
    "    Returns (estimate, standard_error).\n",
    "    \"\"\"\n",
    "    xs = rng.uniform(a, b, size=n)\n",
    "    vals = func(xs)\n",
    "    estimate = (b - a) * vals.mean()\n",
    "    se = (b - a) * vals.std(ddof=1) / np.sqrt(n)\n",
    "    return estimate, se\n",
    "\n",
    "# ── example: ∫₀¹ x² dx = 1/3 ──────────────────────────────────────\n",
    "est, err = monte_carlo_integral(lambda x: x**2, 0, 1)\n",
    "print(f\"MC estimate = {est:.6f} ± {err:.6f}  (true = {1/3:.6f})\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def estimate_polynomial_params(x_data, y_data, degree=2,\n",
    "                                 prior_mu=0, prior_sigma=10,\n",
    "                                 noise_sigma=None,\n",
    "                                 draws=2000, rng_seed=42):\n",
    "    \"\"\"Estimate polynomial coefficients via PyMC / NUTS.\n",
    "    \n",
    "    Parameters\n",
    "    ----------\n",
    "    x_data, y_data : observed data arrays.\n",
    "    degree         : polynomial degree.\n",
    "    prior_mu, prior_sigma : Normal prior params for each coefficient.\n",
    "    noise_sigma    : observation noise std (None → estimated).\n",
    "    draws          : number of posterior draws.\n",
    "    \"\"\"\n",
    "    import pymc as pm\n",
    "    import arviz as az\n",
    "    \n",
    "    def poly(x, params):\n",
    "        result = np.zeros_like(x)\n",
    "        for i, p in enumerate(params):\n",
    "            result += p * x**(degree - i)\n",
    "        return result\n",
    "    \n",
    "    with pm.Model() as model:\n",
    "        params = pm.Normal(\"params\", mu=prior_mu, sigma=prior_sigma,\n",
    "                           shape=degree + 1)\n",
    "        mu = poly(x_data, params)\n",
    "        if noise_sigma is None:\n",
    "            sigma = pm.HalfNormal(\"sigma\", sigma=10)\n",
    "        else:\n",
    "            sigma = noise_sigma\n",
    "        pm.Normal(\"y_obs\", mu=mu, sigma=sigma, observed=y_data)\n",
    "        trace = pm.sample(draws, cores=4, random_seed=rng_seed)\n",
    "    \n",
    "    return trace, model\n",
    "\n",
    "# ── example usage (uncomment to run) ───────────────────────────────\n",
    "# x = np.linspace(-5, 5, 100)\n",
    "# y_true = 2*x**2 - 7*x + 6\n",
    "# y_obs  = y_true + rng.normal(0, 10, size=100)\n",
    "# trace, model = estimate_polynomial_params(x, y_obs, degree=2)\n",
    "# az.plot_posterior(trace, var_names=[\"params\"], figsize=(14, 4))\n",
    "# plt.tight_layout(); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "<a id='utils'></a>\n",
    "## 7. Utilities & Helpers"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def qq_plot(data, dist=\"norm\", **dist_kw):\n",
    "    \"\"\"Quick Q-Q plot to check if `data` follows `dist`.\"\"\"\n",
    "    fig, ax = plt.subplots(figsize=FIG_SIZE)\n",
    "    sp.stats.probplot(data, dist=dist, distargs=tuple(dist_kw.get(\"distargs\", ())),\n",
    "                      fit=True, plot=ax)\n",
    "    ax.set_title(f\"Q-Q Plot — {dist}\")\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "def ks_test(data, dist=\"norm\", **dist_kw):\n",
    "    \"\"\"Kolmogorov-Smirnov goodness-of-fit test.\"\"\"\n",
    "    stat, pval = sp.stats.kstest(data, dist, args=tuple(dist_kw.get(\"args\", ())))\n",
    "    print(f\"KS statistic = {stat:.4f}, p-value = {pval:.4f}\")\n",
    "    if pval < 0.05:\n",
    "        print(\"→ Reject H0: data does NOT come from the specified distribution.\")\n",
    "    else:\n",
    "        print(\"→ Fail to reject H0: data is consistent with the distribution.\")\n",
    "\n",
def multi_histogram(samples_dict, bins=40):
    """Overlay multiple histograms on one axis.
    
    samples_dict : {"label": array, ...}
    """
    fig, ax = plt.subplots(figsize=FIG_SIZE)
    for label, data in samples_dict.items():
        ax.hist(data, bins=bins, density=True, alpha=0.5, label=label)
    ax.set_xlabel("Value"); ax.set_ylabel("Density")
    ax.set_title("Overlaid Histograms")
    ax.legend()
    plt.tight_layout(); plt.show()
    "\n",
    "# ── demo ───────────────────────────────────────────────────────────\n",
    "test_data = rng.normal(5, 3, size=5000)\n",
    "qq_plot(test_data)\n",
    "ks_test(test_data, \"norm\", args=(5, 3))"
   ]
  },
  {
