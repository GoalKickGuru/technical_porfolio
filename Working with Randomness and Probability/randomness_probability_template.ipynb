    "<a id='setup'></a>\n",
    "## 1. Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import scipy as sp\n",
    "from scipy.stats import beta as beta_dist\n",
    "from numpy.random import default_rng, SeedSequence\n",
    "\n",
    "# ── configuration ─────────────────────────────────────────────────\n",
    "SEED       = 42            # change for different streams; None for OS entropy\n",
    "BIT_GEN    = \"PCG64\"       # options: PCG64, MT19937, Philox, SFC64\n",
    "FIG_SIZE   = (8, 4)\n",
    "N_SAMPLES  = 10_000        # default sample count for distribution checks\n",
    "\n",
    "plt.rcParams.update({\n",
    "    \"figure.figsize\": FIG_SIZE,\n",
    "    \"axes.grid\": True,\n",
    "    \"grid.alpha\": 0.3,\n",
    "})\n",
    "\n",
    "def make_rng(seed=SEED, bit_gen=BIT_GEN):\n",
    "    \"\"\"Create a NumPy Generator with the chosen BitGenerator.\"\"\"\n",
    "    bit_map = {\n",
    "        \"PCG64\":  np.random.PCG64,\n",
    "        \"MT19937\": np.random.MT19937,\n",
    "        \"Philox\":  np.random.Philox,\n",
    "        \"SFC64\":   np.random.SFC64,\n",
    "    }\n",
    "    if seed is None:\n",
    "        seed = SeedSequence()\n",
    "    return np.random.Generator(bit_map[bit_gen](seed))\n",
    "\n",
    "rng = make_rng()\n",
    "print(f\"Generator ready — {BIT_GEN}, seed={SEED}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "<a id='discrete'></a>\n",
    "## 2. Discrete Sampling\n",
    "\n",
    "Functions for weighted selection, permutation, and sampling without replacement."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def weighted_choice(items, weights, size=None, replace=True, rng=rng):\n",
    "    \"\"\"Draw from a discrete distribution defined by `weights`.\n",
    "    \n",
    "    Parameters\n",
    "    ----------\n",
    "    items   : 1-D array-like of values to draw from.\n",
    "    weights : 1-D array-like, same length as items. Need NOT sum to 1\n",
    "              (they will be normalised internally).\n",
    "    size    : int or tuple — output shape. None → single scalar.\n",
    "    replace : bool — sample with or without replacement.\n",
    "    \"\"\"\n",
    "    items   = np.asarray(items)\n",
    "    weights = np.asarray(weights, dtype=float)\n",
    "    probs   = weights / weights.sum()\n",
    "    return rng.choice(items, size=size, p=probs, replace=replace)\n",
    "\n",
    "# ── example ───────────────────────────────────────────────────────\n",
    "vals   = [\"A\", \"B\", \"C\", \"D\"]\n",
    "weights = [10, 5, 3, 1]\n",
    "draws = weighted_choice(vals, weights, size=1000)\n",
    "unique, counts = np.unique(draws, return_counts=True)\n",
    "print(dict(zip(unique, counts)))\n",
    "\n",
    "plt.bar(unique, counts/counts.sum(), alpha=0.6, label=\"Empirical\")\n",
    "plt.bar(np.arange(len(vals)), weights/sum(weights), width=0.4,\n",
    "        alpha=0.4, label=\"Theoretical\")\n",
    "plt.title(\"Weighted Discrete Sampling\"); plt.legend()\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "<a id='continuous'></a>\n",
    "## 3. Continuous Distributions\n",
    "\n",
    "Helper to draw, summarise, and plot any NumPy-supported distribution."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "DISTRIBUTIONS = {\n",
    "    # name: (generator_method, default_kwargs)\n",
    "    \"normal\":      (\"normal\",      {\"loc\": 0,   \"scale\": 1}),\n",
    "    \"uniform\":     (\"uniform\",     {\"low\": 0,   \"high\": 1}),\n",
    "    \"exponential\": (\"exponential\", {\"scale\": 1}),\n",
    "    \"gamma\":       (\"gamma\",       {\"shape\": 2,  \"scale\": 2}),\n",
    "    \"beta\":        (\"beta\",        {\"a\": 2,     \"b\": 5}),\n",
    "    \"lognormal\":   (\"lognormal\",   {\"mean\": 0,   \"sigma\": 1}),\n",
    "}\n",
    "\n",
    "def sample_distribution(name, size=N_SAMPLES, rng=rng, **override):\n",
    "    \"\"\"Draw `size` samples from a named distribution.\n",
    "    Returns (samples, method_name, kwargs_used).\n",
    "    \"\"\"\n",
    "    method_name, default_kw = DISTRIBUTIONS[name]\n",
    "    kw = {**default_kw, **override}\n",
    "    method = getattr(rng, method_name)\n",
    "    return method(size=size, **kw), method_name, kw\n",
    "\n",
    "def plot_distribution(name, bins=50, rng=rng, **override):\n",
    "    data, _, kw = sample_distribution(name, rng=rng, **override)\n",
    "    fig, ax = plt.subplots(figsize=FIG_SIZE)\n",
    "    ax.hist(data, bins=bins, density=True, alpha=0.6, color=\"tab:purple\")\n",
    "    ax.set_title(f\"{name.capitalize()} — {kw}\")\n",
    "    ax.set_xlabel(\"Value\"); ax.set_ylabel(\"Density\")\n",
    "    \n",
    "    stats_text = (\n",
    "        f\"mean = {data.mean():.3f}  std = {data.std():.3f}\\n\"\n",
    "        f\"skew = {sp.stats.skew(data):.3f}  kurt = {sp.stats.kurtosis(data):.3f}\"\n",
    "    )\n",
    "    ax.text(0.95, 0.95, stats_text, transform=ax.transAxes,\n",
    "            va=\"top\", ha=\"right\", fontsize=9,\n",
    "            bbox=dict(boxstyle=\"round\", alpha=0.7))\n",
    "    plt.tight_layout(); plt.show()\n",
    "    return data\n",
    "\n",
    "# ── example: normal with custom params ────────────────────────────\n",
    "_ = plot_distribution(\"normal\", loc=5, scale=3)\n",
    "_ = plot_distribution(\"beta\", a=3, b=7)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "<a id='processes'></a>\n",
    "## 4. Random Processes\n",
    "\n",
    "Generic Poisson-process simulator and a configurable Markov-chain runner."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def simulate_poisson_process(rate, n_events=50, rng=rng):\n",
    "    \"\"\"Return (arrival_times, inter_arrival_times, counts).\"\"\"\n",
    "    inter = rng.exponential(scale=1/rate, size=n_events)\n",
    "    arrivals = np.add.accumulate(inter)\n",
    "    counts = np.arange(1, n_events + 1)\n",
    "    return arrivals, inter, counts\n",
    "\n",
    "def simulate_markov_chain(T, start=0, steps=200, rng=rng):\n",
    "    \"\"\"Simulate a discrete homogeneous Markov chain.\n",
    "    \n",
    "    T     : (n×n) transition matrix (rows sum to 1).\n",
    "    start : initial state index.\n",
    "    steps : number of transitions.\n",
    "    \"\"\"\n",
    "    n = T.shape[0]\n",
    "    states = np.empty(steps + 1, dtype=int)\n",
    "    states[0] = start\n",
    "    for t in range(steps):\n",
    "        states[t+1] = rng.choice(n, p=T[states[t]])\n",
    "    return states\n",
    "\n",
    "def stationary_distribution(T):\n",
    "    \"\"\"Compute the stationary distribution of a Markov chain.\"\"\"\n",
    "    evals, evecs = np.linalg.eig(T.T)\n",
    "    vec = evecs[:, np.isclose(evals, 1)].real.flatten()\n",
    "    return vec / vec.sum()\n",
    "\n",
    "# ── example: Poisson process ───────────────────────────────────────\n",
    "arr, inter, cnt = simulate_poisson_process(rate=4.0, n_events=50, rng=rng)\n",
    "fig, ax = plt.subplots(figsize=FIG_SIZE)\n",
    "ax.step(arr, cnt, where=\"post\")\n",
    "ax.set_title(\"Poisson Process (λ=4)\"); ax.set_xlabel(\"Time\"); ax.set_ylabel(\"Cumulative arrivals\")\n",
    "plt.tight_layout(); plt.show()\n",
    "\n",
    "# ── example: 3-state Markov chain ─────────────────────────────────\n",
    "T3 = np.array([[0.6, 0.3, 0.1],\n",
    "               [0.2, 0.5, 0.3],\n",
    "               [0.1, 0.1, 0.8]])\n",
    "chain = simulate_markov_chain(T3, steps=1000, rng=rng)\n",
    "pi = stationary_distribution(T3)\n",
    "emp = np.bincount(chain, minlength=3) / len(chain)\n",
    "print(f\"Stationary  = {pi.round(4)}\")\n",
    "print(f\"Empirical   = {emp.round(4)}\")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=FIG_SIZE)\n",
    "x = np.arange(3)\n",
    "ax.bar(x - 0.2, pi,  0.4, label=\"Stationary\", alpha=0.7)\n",
    "ax.bar(x + 0.2, emp, 0.4, label=\"Empirical\",  alpha=0.7)\n",
    "ax.set_xticks(x); ax.set_title(\"3-State Markov Chain Distribution\")\n",
    "ax.legend(); plt.tight_layout(); plt.show()"
   ]
  },
