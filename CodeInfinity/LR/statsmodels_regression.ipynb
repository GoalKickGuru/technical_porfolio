            "Test set:     30 samples"
          ]
        }
      ],
      "source": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Step 5B: Build and Train the Polynomial Model\n",
        "\n",
        "We pass `add_polynomial=True, degree=2` to the wrapper class."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Build and train the polynomial model\n",
        "poly_model = LinearRegressionStatsmodels(add_polynomial=True, degree=2)\n",
        "poly_model.fit(X_poly_train, y_poly_train)\n",
        "\n",
        "# Print the full summary\n",
        "poly_model.print_summary()"
      ]
