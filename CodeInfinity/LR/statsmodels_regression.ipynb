        "\n",
        "# Evaluate\n",
        "train_metrics = linear_model.evaluate(y_lin_train, y_lin_train_pred, label='TRAINING SET')\n",
        "test_metrics = linear_model.evaluate(y_lin_test, y_lin_test_pred, label='TEST SET')\n",
        "\n",
        "# Overfitting check\n",
        "ratio = test_metrics['rmse'] / train_metrics['rmse']\n",
        "print(f\"\\nRMSE Ratio (Test/Train): {ratio:.2f}\")\n",
        "if ratio > 1.5:\n",
        "    print(\"⚠ Overfitting suspected!\")\n",
        "elif ratio > 1.2:\n",
        "    print(\"⚠ Mild overfitting possible\")\n",
