        "---\n",
        "## Part A: Multiple Linear Regression\n",
        "\n",
        "### Step 4A: Prepare Features and Split\n",
        "\n",
        "We use `age` and `square_feet` to predict `price`."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Prepare features and target\n",
        "X_lin = df_linear[['age', 'square_feet']]\n",
        "y_lin = df_linear['price']\n",
        "\n",
        "# Split into train/test (70/30)\n",
        "X_lin_train, X_lin_test, y_lin_train, y_lin_test = train_test_split(\n",
        "    X_lin, y_lin, test_size=0.3, random_state=42\n",
        ")\n",
        "\n",
        "print(f\"Training set: {len(X_lin_train)} samples\")\n",
        "print(f\"Test set:     {len(X_lin_test)} samples\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
